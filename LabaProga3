program IntegralWithError;

uses Math;

const
  X_LIMIT = -2.53488;

function f(x: real): real;
begin
  f := x*x*x - 2*x*x - 4*x + 19;
end;

function PrimF(x: real): real;
begin
  PrimF := x*x*x*x/4 - 2*x*x*x/3 - 2*x*x + 19*x;
end;

procedure ReadRealSafe(var x: real; prompt: string);
var
  s: string;
  code, i: integer;
begin
  repeat
    write(prompt);
    readln(s);
    for i := 1 to length(s) do
      if s[i] = ',' then s[i] := '.';
    val(s, x, code);
    if code <> 0 then
      writeln('Ошибка: введи число.');
  until code = 0;
end;

procedure ReadIntSafe(var x: integer; prompt: string);
var
  s: string;
  code: integer;
begin
  repeat
    write(prompt);
    readln(s);
    val(s, x, code);
    if (code <> 0) or (x <= 0) then
      writeln('Ошибка: нужно положительное целое число.');
  until (code = 0) and (x > 0);
end;

procedure ReadMenu(var x: integer);
var
  s: string;
  code: integer;
begin
  repeat
    write('Выбор: ');
    readln(s);
    val(s, x, code);
    if code <> 0 then
      writeln('Ошибка: в меню вводят цифры.');
  until code = 0;
end;

function TrapArea(a, b: real; n: integer): real;
var
  h, s, f1, f2: real;
  i: integer;
begin
  h := (b - a) / n;
  s := 0;

  for i := 0 to n - 1 do
  begin
    f1 := f(a + i * h);
    if f1 < 0 then f1 := 0;

    f2 := f(a + (i + 1) * h);
    if f2 < 0 then f2 := 0;

    s := s + (f1 + f2) * h / 2;
  end;

  TrapArea := s;
end;

function ExactArea(a, b: real): real;
var
  lowBound, highBound: real;
begin
  // Берем только ту часть интервала, которая больше корня (где f(x) > 0)
  if a < X_LIMIT then lowBound := X_LIMIT else lowBound := a;
  if b < X_LIMIT then highBound := X_LIMIT else highBound := b;
  
  if highBound > lowBound then
    ExactArea := PrimF(highBound) - PrimF(lowBound)
  else
    ExactArea := 0; // Вся фигура ниже оси OX
end;

function AbsError(approx, exact: real): real;
begin
  AbsError := abs(approx - exact);
end;

function RelError(approx, exact: real): real;
begin
  if exact = 0 then
    RelError := 0
  else
    RelError := (abs(approx - exact) / exact) * 100;
end;

var
  a, b: real;
  n, choice: integer;
  trap, exact: real;
  dataReady: boolean;

begin
  dataReady := false;

  repeat
    writeln;
    writeln('==============================');
    writeln('1 - Ввести пределы');
    writeln('2 - Площадь (трапеции)');
    writeln('3 - Интеграл (Ньютон-Лейбниц)');
    writeln('4 - Погрешности');
    writeln('0 - Выход');
    writeln('==============================');

    ReadMenu(choice);

    case choice of
      1: begin
           ReadRealSafe(a, 'Введите нижний предел a: ');
           ReadRealSafe(b, 'Введите верхний предел b: ');

           if a < X_LIMIT then
           begin
             writeln('a ограничено снизу: ', X_LIMIT:0:5);
             a := X_LIMIT;
           end;

           if b < X_LIMIT then
           begin
             writeln('b меньше допустимого. Площадь = 0.');
             dataReady := false;
           end
           else if a >= b then
           begin
             writeln('Ошибка: a должно быть меньше b.');
             dataReady := false;
           end
           else
           begin
             ReadIntSafe(n, 'Введите n: ');
             dataReady := true;
           end;
         end;

      2: if dataReady then
           begin
             trap := TrapArea(a, b, n);
             writeln('Площадь (трапеции) = ', trap:0:6);
           end
         else writeln('Сначала введи пределы.');

      3: if dataReady then
           begin
             exact := ExactArea(a, b);
             writeln('Интеграл (Ньютон–Лейбниц) = ', exact:0:6);
           end
         else writeln('Сначала введи пределы.');

      4: if dataReady then
           begin
             trap := TrapArea(a, b, n);
             exact := ExactArea(a, b);

             writeln('Абсолютная погрешность = ',
                     AbsError(trap, exact):0:6);
             writeln('Относительная погрешность = ',
                     RelError(trap, exact):0:6);
           end
         else writeln('Сначала введи пределы.');

      0: writeln('Выход. Паскаль сегодня выжил');
    else
      writeln('Нет такого пункта');
    end;

  until choice = 0;
end.
